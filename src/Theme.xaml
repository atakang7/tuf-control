<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <SolidColorBrush x:Key="Bg" Color="#000000" />
  <SolidColorBrush x:Key="Sidebar" Color="#050506" />
  <SolidColorBrush x:Key="Surface" Color="#0B0B0D" />
  <SolidColorBrush x:Key="Surface2" Color="#131316" />
  <SolidColorBrush x:Key="Surface3" Color="#1C1C21" />
  <SolidColorBrush x:Key="Stroke" Color="#19191E" />
  <SolidColorBrush x:Key="StrokeStrong" Color="#27272E" />
  <SolidColorBrush x:Key="Text" Color="#F4F4F6" />
  <SolidColorBrush x:Key="TextSec" Color="#A1A1AA" />
  <SolidColorBrush x:Key="TextMuted" Color="#63636B" />
  <SolidColorBrush x:Key="Accent" Color="#FF2D46" />
  <SolidColorBrush x:Key="AccentSoft" Color="#1FFF2D46" />
  <SolidColorBrush x:Key="AccentInk" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Good" Color="#3DD68C" />
  <SolidColorBrush x:Key="GoodSoft" Color="#1A3DD68C" />
  <SolidColorBrush x:Key="Warn" Color="#F5B83D" />
  <SolidColorBrush x:Key="WarnSoft" Color="#1AF5B83D" />
  <SolidColorBrush x:Key="Bad" Color="#FF5D5D" />
  <SolidColorBrush x:Key="BadSoft" Color="#1AFF5D5D" />
  <SolidColorBrush x:Key="CpuBrush" Color="#4CC2FF" />
  <SolidColorBrush x:Key="GpuBrush" Color="#A78BFA" />
  <Style x:Key="T.Display" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style x:Key="T.Title" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style x:Key="T.Label" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style x:Key="T.Overline" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style x:Key="T.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextBlock.LineHeight" Value="20" />
  </Style>
  <Style x:Key="T.Caption" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextBlock.LineHeight" Value="18" />
  </Style>
  <Style x:Key="T.Icon" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
  </Style>
  <Style x:Key="T.Value" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="16" />
    <Setter Property="Border.Padding" Value="20" />
  </Style>
  <Style x:Key="Well" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="Border.CornerRadius" Value="12" />
    <Setter Property="Border.Padding" Value="14,12" />
  </Style>
  <Style x:Key="Divider" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Stroke}" />
    <Setter Property="Margin" Value="0,18" />
  </Style>
  <Style x:Key="Chip" TargetType="{x:Type Border}">
    <Setter Property="Border.CornerRadius" Value="20" />
    <Setter Property="Border.Padding" Value="10,4" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
  </Style>
  <Style x:Key="IconTile" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Border.CornerRadius" Value="10" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border Name="B" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2" />
            <Border Name="H" CornerRadius="2" Background="#FFFFFF" Opacity="0" IsHitTestVisible="False" />
            <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="Center">
              <TextBlock Name="Ic" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="{StaticResource IconFont}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="{x:Null}">
              <Setter TargetName="Ic" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Content" Value="{x:Null}">
              <Setter TargetName="Ic" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="H" Property="UIElement.Opacity" Value="0.05" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="H" Property="UIElement.Opacity" Value="0.09" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="B" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style x:Key="Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
  </Style>
  <Style x:Key="Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource BadSoft}" />
    <Setter Property="BorderBrush" Value="#33FF5D5D" />
    <Setter Property="Foreground" Value="#FF8A8A" />
  </Style>
  <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
  </Style>
  <Style x:Key="ChromeButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="B" Background="#00FFFFFF">
            <TextBlock Text="{TemplateBinding ContentControl.Content}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Control.Foreground}" FontFamily="{StaticResource IconFont}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="#14FFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="UIElement.IsMouseOver" Value="True" />
                <Condition Property="FrameworkElement.Tag" Value="close" />
              </MultiTrigger.Conditions>
              <Setter TargetName="B" Property="Border.Background" Value="#E81123" />
              <Setter Property="Foreground" Value="#FFFFFFFF" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="RadioButton.GroupName" Value="Nav" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Height="42" Margin="0,2" Background="#00FFFFFF">
            <Border Name="Bg" CornerRadius="2" Background="#00FFFFFF" />
            <Border Name="Bar" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Opacity="0" />
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Name="Ic" FontSize="16" Width="22" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextMuted}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="#0AFFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Border.Background" Value="{StaticResource Surface2}" />
              <Setter TargetName="Bar" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="Ic" Value="{DynamicResource Accent}" Property="TextBlock.Foreground" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ModeCard" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="RadioButton.GroupName" Value="Mode" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Card" BorderThickness="1" CornerRadius="2" Padding="16,16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Name="Tile" Width="42" Height="42" CornerRadius="2" Background="{StaticResource Surface2}">
                <TextBlock Name="Ic" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextSec}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              </Border>
              <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
              <Rectangle Name="Dot" Grid.Column="1" Width="8" Height="8" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Card" Property="Border.BorderBrush" Value="{StaticResource StrokeStrong}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Card" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
              <Setter TargetName="Card" Value="{DynamicResource AccentSoft}" Property="Border.Background" />
              <Setter TargetName="Tile" Value="{DynamicResource Accent}" Property="Border.Background" />
              <Setter TargetName="Ic" Property="TextBlock.Foreground" Value="{StaticResource AccentInk}" />
              <Setter TargetName="Dot" Property="UIElement.Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegmentHost" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="11" />
    <Setter Property="Border.Padding" Value="3" />
  </Style>
  <Style x:Key="Segment" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="B" CornerRadius="2" Background="#00FFFFFF" Padding="8,7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="{StaticResource Surface3}" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0" RecognizesAccessKey="True" />
            <Border Name="Track" Grid.Column="1" Width="40" Height="22" CornerRadius="2" BorderThickness="1" VerticalAlignment="Center" Background="{StaticResource Surface3}" BorderBrush="{StaticResource StrokeStrong}">
              <Rectangle Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="3,0,0,0" Fill="{StaticResource TextSec}">
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="KnobX" />
                </UIElement.RenderTransform>
              </Rectangle>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Track" Value="{DynamicResource Accent}" Property="Border.Background" />
              <Setter TargetName="Track" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
              <Setter TargetName="Knob" Property="Shape.Fill" Value="{StaticResource AccentInk}" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobX" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Border.BorderBrush" Value="{StaticResource TextMuted}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFillH" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Background="#00FFFFFF">
            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Control.Background}" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderFillV" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Grid Background="#00FFFFFF">
            <Border Width="4" CornerRadius="2" Background="{TemplateBinding Control.Background}" HorizontalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid>
            <Rectangle Name="Halo" Opacity="0" RenderTransformOrigin="0.5,0.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="1.8" ScaleY="1.8" />
              </UIElement.RenderTransform>
            </Rectangle>
            <Rectangle Fill="#F4F6FA" />
            <Rectangle Width="8" Height="8" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Halo" Property="UIElement.Opacity" Value="0.2" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="Halo" Property="UIElement.Opacity" Value="0.3" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="SliderH" TargetType="{x:Type Slider}">
    <Grid Background="#00FFFFFF" Height="26">
      <Track Name="PART_Track">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Control.Foreground}" Style="{StaticResource SliderFillH}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderFillH}" Background="{StaticResource Surface3}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource SliderThumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="SliderV" TargetType="{x:Type Slider}">
    <Grid Background="#00FFFFFF" Width="26">
      <Track Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="{TemplateBinding Control.Foreground}" Style="{StaticResource SliderFillV}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{StaticResource SliderFillV}" Background="{StaticResource Surface3}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource SliderThumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Slider.IsSnapToTickEnabled" Value="True" />
    <Setter Property="Slider.TickFrequency" Value="1" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template" Value="{StaticResource SliderH}" />
    <Style.Triggers>
      <Trigger Property="Slider.Orientation" Value="Vertical">
        <Setter Property="Template" Value="{StaticResource SliderV}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.35" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="B" CornerRadius="2" Padding="10,8" Margin="0,1" Background="#00FFFFFF">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="{StaticResource Surface3}" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="B" Value="{DynamicResource AccentSoft}" Property="Border.Background" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="12,8,34,8" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="B" CornerRadius="2" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                    <TextBlock Text="" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource TextSec}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="B" Property="Border.BorderBrush" Value="{StaticResource TextMuted}" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="B" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <Popup Name="PART_Popup" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" Placement="Bottom" VerticalOffset="6" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border BorderThickness="1" CornerRadius="2" Padding="4" Margin="0,0,10,10" Background="{StaticResource Surface2}" BorderBrush="{StaticResource StrokeStrong}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <UIElement.Effect>
                  <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </UIElement.Effect>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource Text}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="B" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Border.BorderBrush" Value="{StaticResource TextMuted}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="B" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="B" CornerRadius="2" Background="#2A303D" Margin="2" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="#3C4456" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="#4A5368" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="VScroll" TargetType="{x:Type ScrollBar}">
    <Grid Background="#00FFFFFF" Width="10">
      <Track Name="PART_Track" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Style="{StaticResource ScrollPage}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Style="{StaticResource ScrollPage}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="HScroll" TargetType="{x:Type ScrollBar}">
    <Grid Background="#00FFFFFF" Height="10">
      <Track Name="PART_Track" Orientation="Horizontal">
        <Track.DecreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Style="{StaticResource ScrollPage}" />
        </Track.DecreaseRepeatButton>
        <Track.IncreaseRepeatButton>
          <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Style="{StaticResource ScrollPage}" />
        </Track.IncreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource ScrollThumb}" />
        </Track.Thumb>
      </Track>
    </Grid>
  </ControlTemplate>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template" Value="{StaticResource VScroll}" />
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Template" Value="{StaticResource HScroll}" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource TextSec}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Grid Margin="0,2">
            <Border Name="B" CornerRadius="2" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="1" Padding="12,10">
              <ContentPresenter />
            </Border>
            <Border Name="Bar" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="#0AFFFFFF" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="ListBoxItem.IsSelected" Value="True">
              <Setter TargetName="B" Property="Border.Background" Value="{StaticResource Surface2}" />
              <Setter TargetName="B" Property="Border.BorderBrush" Value="{StaticResource StrokeStrong}" />
              <Setter TargetName="Bar" Property="UIElement.Opacity" Value="1" />
              <Setter Property="Foreground" Value="{StaticResource Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border BorderThickness="1" CornerRadius="2" Padding="10,6" Background="{StaticResource Surface3}" BorderBrush="{StaticResource StrokeStrong}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>