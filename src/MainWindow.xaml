                          <StackPanel>
                            <local:InfoLabel Text="Windows ile başlat" Info="{x:Static local:Lang+Info.Startup}" LabelStyle="{StaticResource CardHead}" />
                            <TextBlock Name="StartupState" Text="Kontrol ediliyor…" Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                          </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Oturum açıldıktan birkaç saniye sonra bildirim alanında başlar. Açıp kapatmak için yönetici yetkisi gerekir." Style="{StaticResource T.Caption}" Margin="0,12,0,0" />
                        <Button Content="Yönetici olarak yeniden aç" Tag="" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Elevate" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                      <StackPanel>
                        <local:InfoLabel Text="Açılışta uygulanacak profil" Info="{x:Static local:Lang+Info.StartupProfile}" LabelStyle="{StaticResource CardHead}" />
                        <TextBlock Text="Bilgisayar açılınca hangi ayarın kullanılacağını seç." Style="{StaticResource T.Caption}" Margin="0,3,0,14" />
                        <ComboBox Name="StartupChoiceBox" SelectionChanged="StartupChoiceChanged">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                      <StackPanel>
                        <local:InfoLabel Text="Otomatik profil geçişi" Info="{x:Static local:Lang+Info.AutoSwitch}" LabelStyle="{StaticResource CardHead}" />
                        <TextBlock Text="Hangi profilin ne zaman devreye gireceğini belirle. Açılışta ve uykudan dönüşte de uygulanır." Style="{StaticResource T.Caption}" Margin="0,3,0,14" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition />
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="Prize takılıyken" Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                            <ComboBox Name="AcPicker" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="Bataryadayken" Style="{StaticResource T.Caption}" Margin="0,0,0,6" />
                            <ComboBox Name="BatteryPicker" />
                          </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="Uygulama kuralları" Style="{StaticResource T.Label}" />
                        <TextBlock Text="Listelenen oyun ya da uygulama açıkken seçtiğin profil devreye girer; kapanınca priz/batarya profiline dönülür. Birden fazla uygulama açıksa üstteki kural geçerlidir." Style="{StaticResource T.Caption}" Margin="0,3,0,10" />
                        <ItemsControl Name="RulesList">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Style="{StaticResource Well}" Padding="12,8" Margin="0,0,0,8">
                                <DockPanel>
                                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="" Margin="8,0,0,0" Width="32" Height="32" ToolTip="Kuralı sil" Click="RemoveRule" />
                                  <ComboBox DockPanel.Dock="Right" Width="170" Background="{StaticResource Surface}" ItemsSource="{Binding ProfileNames, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Profile, Mode=TwoWay}" SelectionChanged="AutoSettingChanged" />
                                  <TextBlock Text="" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                  <TextBlock FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Process, StringFormat='{}{0}.exe'}" />
                                </DockPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content="Gözat…" Tag="" Margin="8,0,0,0" Click="BrowseRule" />
                          <Button DockPanel.Dock="Right" Content="Ekle" Tag="" Margin="8,0,0,0" Click="AddRule" />
                          <ComboBox Name="RunningApps" DropDownOpened="RefreshRunningApps" />
                        </DockPanel>
                        <TextBlock Name="RulesHint" Text="Açık uygulamalardan birini seç ya da Gözat ile bir .exe dosyası ekle." Style="{StaticResource T.Caption}" Margin="0,6,0,0" />
                        <Border Style="{StaticResource Divider}" />
                        <CheckBox Name="AutoApply">
                          <StackPanel>
                            <TextBlock Text="Otomatik geçişi etkinleştir" Style="{StaticResource T.Label}" />
                            <TextBlock Text="Kapalıyken profiller yalnızca elle uygulanır." Style="{StaticResource T.Caption}" />
                          </StackPanel>
                        </CheckBox>
                        <TextBlock Text="Değişiklikler anında kaydedilir." Style="{StaticResource T.Caption}" Margin="0,12,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                      <StackPanel>
                        <CheckBox Name="BootEarlyBox" Click="BootEarlyClick">
                          <StackPanel>
                            <local:InfoLabel Text="Erken başlatma (oturum açılmadan önce)" Info="{x:Static local:Lang+Info.BootEarly}" LabelStyle="{StaticResource CardHead}" />
                            <TextBlock Text="Windows açılırken, daha sen oturum açmadan, seçili açılış profilinin güç ve fan ayarları uygulanır; ilk dakikadaki yüksek fan ve sıcaklık azalır." Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                          </StackPanel>
                        </CheckBox>
                        <TextBlock Name="BootEarlyState" Text="" Style="{StaticResource T.Caption}" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                      <StackPanel>
                        <CheckBox Name="RecordHistoryBox" IsChecked="True" Click="RecordHistoryClick">
                          <StackPanel>
                            <local:InfoLabel Text="Ölçüm geçmişini kaydet" Info="{x:Static local:Lang+Info.HistoryLog}" LabelStyle="{StaticResource CardHead}" />
                            <TextBlock Text="Sensör değerleri ve her kullanım dönemi (açılış/uyanıştan uykuya) için min, ortalama ve maks özetleri yalnızca bu bilgisayarda saklanır; ayarlarını sonradan iyileştirmek için kullanılır." Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                          </StackPanel>
                        </CheckBox>
                        <DockPanel Margin="0,12,0,0">
                          <Button DockPanel.Dock="Right" Content="Klasörü aç" Tag="" Click="OpenHistory" />
                          <TextBlock Name="HistorySize" Text="" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                      <CheckBox Name="ExternalStd" IsChecked="True" Click="ExternalStdClick">
                        <StackPanel>
                          <local:InfoLabel Text="Harici ekran takılıyken RTX'i açık tut" Info="{x:Static local:Lang+Info.ExternalStd}" LabelStyle="{StaticResource CardHead}" />
                          <TextBlock Text="HDMI bu laptopta RTX'e bağlıdır. Harici ekran varken Eco profilleri Standart çalışır; ekran çıkarılınca Eco'ya dönülür." Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                      </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                      <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}" Width="200" VerticalAlignment="Center">
                          <UniformGrid Columns="2">
                            <RadioButton Name="LangTr" Style="{StaticResource Segment}" GroupName="Lang" Content="Türkçe" IsChecked="True" Click="LanguageClick" />
                            <RadioButton Name="LangEn" Style="{StaticResource Segment}" GroupName="Lang" Content="English" Click="LanguageClick" />
                          </UniformGrid>
                        </Border>
                        <StackPanel>
                          <TextBlock Text="Dil" Style="{StaticResource CardHead}" />
                          <TextBlock Text="Uygulama dili. Seçim anında uygulanır." Style="{StaticResource T.Caption}" Margin="0,3,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                      <StackPanel>
                        <TextBlock Text="Profil yedeği" Style="{StaticResource CardHead}" />
                        <TextBlock Text="İçe aktarma otomatik uygulamayı kapatır." Style="{StaticResource T.Caption}" Margin="0,3,0,14" />
                        <StackPanel Orientation="Horizontal">
                          <Button Content="İçe aktar" Tag="" Margin="0,0,8,0" Click="ImportProfiles" />
                          <Button Content="Dışa aktar" Tag="" Click="ExportProfiles" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                      <StackPanel>
                        <TextBlock Text="Hakkında" Style="{StaticResource CardHead}" />
                        <TextBlock Name="AboutText" Style="{StaticResource T.Body}" Margin="0,8,0,0" Text="TUF Control v2.1 · GPL-3.0. G-Helper ve PawnIO.Modules kaynaklarından uyarlanan bileşenler içerir. ASUS ile bağlantılı değildir." />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </TabItem>
          </TabControl>
          <Border Grid.Row="2" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
              <TextBlock Name="AppliedLabel" DockPanel.Dock="Right" Text="Henüz bir ayar uygulanmadı" Style="{StaticResource T.Caption}" VerticalAlignment="Center" />
              <Rectangle Name="StatusDot" Width="7" Height="7" Fill="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Name="StatusText" Text="İzleme hazır." FontSize="12.5" Foreground="{StaticResource TextSec}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>